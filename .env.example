# PayPal sandbox app (Developer Dashboard > Apps & Credentials > Sandbox). Sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: payee merchant id for the chargeback simulator (otherwise read from the order response)
PAYPAL_MERCHANT_ID=
# Optional: verifies webhook signatures when PayPal can reach /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Nebius Token Factory (OpenAI-compatible). NEBIUS_MODEL is optional; a Nemotron model is picked from /models.
NEBIUS_BASE_URL=
NEBIUS_API_KEY=
NEBIUS_MODEL=

# Background polling of the Disputes API (1 = on)
WARRANT_POLL=1
WARRANT_POLL_SECONDS=15
